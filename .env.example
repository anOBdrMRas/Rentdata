# Port des Servers
PORT=3000
# Optional: Google Maps API-Key (Maps JavaScript API + Geocoding API).
# Ohne Key wird automatisch OpenStreetMap (Leaflet + Nominatim) verwendet.
GOOGLE_MAPS_API_KEY=
# Speicherort für Datenbank und hochgeladene Dateien
DATA_DIR=./data
# Passwortschutz (dringend empfohlen, sobald die App im Internet erreichbar ist)
APP_USER=admin
APP_PASSWORD=
# Demodaten beim ersten Start laden (true/false)
DEMO_DATA=true
